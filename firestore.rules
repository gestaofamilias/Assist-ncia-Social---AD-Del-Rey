rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: families
    // Fields: name (string), status (string), userId (string), etc.
    //
    // Collection: financial_records
    // Fields: type (string), amount (number), userId (string), etc.
    //
    // Collection: inventory_items
    // Fields: name (string), quantity (number), userId (string), etc.
    //
    // ===============================================================

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.userId;
    }

    function isValidFamily(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() < 200;
    }

    function isValidFinancial(data) {
      return data.amount is number && data.type in ['Income', 'Expense'];
    }

    function isValidInventory(data) {
      return data.name is string && data.quantity is number;
    }

    match /families/{familyId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidFamily(request.resource.data) && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && isValidFamily(request.resource.data) && (isDocOwner() || request.resource.data.userId == request.auth.uid);
      allow delete: if isDocOwner();
    }

    match /financial_records/{recordId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidFinancial(request.resource.data) && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && isValidFinancial(request.resource.data) && (isDocOwner() || request.resource.data.userId == request.auth.uid);
      allow delete: if isDocOwner();
    }

    match /inventory_items/{itemId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidInventory(request.resource.data) && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && isValidInventory(request.resource.data) && (isDocOwner() || request.resource.data.userId == request.auth.uid);
      allow delete: if isDocOwner();
    }
  }
}
